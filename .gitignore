# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries
*.exe
*.exe~
*.dll
*.dylib
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# Project
# Secrets — never commit credentials
*.cert
*.key
*.pem
*.p12
*.pfx
credentials*.json
*.log
bin/
# GoReleaser output; untracked files here mark release binaries +dirty
/dist/
*.env
*.yaml
!.goreleaser.yaml
CLAUDE.md
/zlib

# Develop Tools
.vscode/
.idea/
.claude/
*.swp
.playwright-mcp/
*.png

# Site assets that must ship despite the *.png rule above
!site/og.png

# Generated by scripts/build-zh.mjs during the pages workflow
site/zh/

# Local session handoff notes
/docs/handoff.md

# ZCode agent session directory
.zcode/
